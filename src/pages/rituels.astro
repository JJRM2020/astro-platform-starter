---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Restez libre dans vos pensées, vos actions, votre vie...

`;
---

<Layout title="Mgr Rémy, evêque exorciste">
    <h1 class="mb-10">Père Remy, exorciste, conjurateur à votre service</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />
    
    <br/>
</Layout>
